# Copy to .env and adjust. All values are optional — the demo runs offline
# with no configuration at all.
ELT_WAREHOUSE_PATH=./elt-demo-data/warehouse.db
ELT_MANIFEST_DIR=./elt-demo-data/manifests
ELT_EXPORT_ROOT=./elt-demo-data/warehouse_files
ELT_API_HOST=0.0.0.0
ELT_API_PORT=8000
ELT_MAX_RETRIES=1
